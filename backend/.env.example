# MediConnect Backend Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mediconnect
DB_CONNECTION_LIMIT=10

# Authentication & Security
JWT_SECRET=mediconnect-super-secure-production-ready-jwt-secret-key-2026
JWT_EXPIRES_IN=24h

# Google OAuth 2.0 (for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# AI Document Summarization (Gemini API)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
ENABLE_MOCK_SUMMARIZATION=true

# File Uploads (Private Storage)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
